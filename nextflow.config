// Google Batch / Seqera Platform profile.
//
// This pipeline has no environment definition of its own -- see the Dockerfile in this repo.
// container_image defaults to a personal Docker Hub image built from that Dockerfile
// (docker.io/swekhande/sw-dockers:sceptre-pipeline), kept only as a convenience so this profile
// works out of the box; it is not an official or maintained registry for this project, and
// should be replaced with a project-owned one before relying on this long-term. Override with
// --container_image to point at your own build.

params.container_image = params.container_image ?: 'docker.io/swekhande/sw-dockers:sceptre-pipeline'

profiles {
  google_batch {
    process.executor = 'google-batch'
    wave.enabled      = true
    fusion.enabled    = true

    // A script-level `time {...}` directive always overrides a blanket process.time set from
    // outside -- only a withName-scoped override beats it. run_association_analysis hard-codes
    // `time {run_association_analysis_time_per_pair * pair_pod_size}`, which defaults to a
    // 50-second budget at pair_pod_size=1000 -- measured real cost is 1-2 orders of magnitude
    // higher. Without these overrides, every Google Batch task using that process fails with a
    // Google Batch-level timeout that never even shows up as a normal Nextflow error.
    process {
      withName: assign_grnas {
        time = '2h'
      }
      withName: run_qc {
        time = '4h'
      }
      withName: 'run_analysis_subworkflow_calibration_check:run_association_analysis' {
        time = '4h'
      }
      withName: 'run_analysis_subworkflow_power_check:run_association_analysis' {
        time = '4h'
      }
      withName: 'run_analysis_subworkflow_discovery_analysis:run_association_analysis' {
        time = '4h'
      }
    }

    if (!params.container_image) {
      System.err.println("profile 'google_batch' requires --container_image -- build one from " +
        "the Dockerfile in this repo (docker build, or via Seqera Wave) and pass the resulting " +
        "reference explicitly. No default is set here: this repo has no durable registry of its " +
        "own to point at.")
      System.exit(1)
    }
    process.container = params.container_image
  }
}
